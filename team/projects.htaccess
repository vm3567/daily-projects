# worktask.in/projects/ = the Daily Projects app. Its AI helper talks to Anthropic / Google directly,
# so this folder allows those (the rest of worktask.in allows only itself).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://api.anthropic.com https://generativelanguage.googleapis.com; img-src 'self' blob: data:; frame-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; manifest-src 'self'; frame-ancestors 'none'"
  Header always set Permissions-Policy "geolocation=(), camera=(self), microphone=(self)"
</IfModule>
<FilesMatch "\.(html|js|css|webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>

AddType application/manifest+json .webmanifest
